# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
client/node_modules
server/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# builds
/build
/dist
client/dist
server/dist
/.next/
/out/

# environment files (STRICTLY IGNORED)
.env
.env*
*.env
client/.env*
server/.env*
server/.env
client/.env

# keep example templates
!.env.example
!client/.env.example
!server/.env.example

# logs & debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
server/boot.log
server/boot.err

# system & editor
.DS_Store
Thumbs.db
*.pem
*.bak
*.bak*
.vscode/
.idea/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
